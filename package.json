{
  "name": "planup",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @planup/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run seed:demo:dry-run && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:demo": "node scripts/manage-demo-data.mjs seed --confirm-dev",
    "seed:demo:dry-run": "node scripts/manage-demo-data.mjs seed --dry-run",
    "cleanup:demo": "node scripts/manage-demo-data.mjs cleanup --confirm-dev"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
